# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data — auto-generated, do not commit
data/scheduled-posts.json

# WhatsApp Engine credentials and runtime data
jarvis-whatsapp-engine/auth_state/
jarvis-whatsapp-engine/node_modules/
jarvis-whatsapp-engine/.env

.vercel

# SQL scripts with potential credentials
run-sql*.js

# Build logs
*.log
build_output*.txt
ts_check*.txt
